@page "/"
@rendermode InteractiveServer
@inject StubService StubSvc
@inject GroupService Groups
@inject ConfigHistoryService History
@inject IConfigPorter Porter
@inject NavigationManager Nav

<h1>Stubs</h1>

<div class="toolbar">
    <button @onclick="@(() => Nav.NavigateTo("/stubs/new"))">New stub</button>
    <input type="text" placeholder="New group name" @bind="_newGroupName" />
    <button @onclick="AddGroupAsync">Add group</button>
    <button @onclick="UndoAsync" disabled="@(!_canUndo)">Undo</button>
    <button @onclick="RedoAsync" disabled="@(!_canRedo)">Redo</button>
</div>

<div class="toolbar">
    <a href="/export" target="_blank" rel="noopener">Export</a>
    <label>Import mode
        <select @bind="_importMode">
            <option value="@ImportMode.ReplaceAll">Replace all</option>
            <option value="@ImportMode.Merge">Merge</option>
        </select>
    </label>
    <InputFile OnChange="OnImportAsync" accept=".json" />
</div>

@if (_importError is not null)
{
    <p style="color:#b00020">Import failed: @_importError</p>
}

@if (_tree is null)
{
    <p>Loading…</p>
}
else if (_tree.Children.Count == 0 && _tree.Stubs.Count == 0)
{
    <p>No stubs or groups yet. Create one to start mocking.</p>
}
else
{
    <GroupTreeView Node="_tree"
                   PendingDeleteGroupId="_pendingDeleteGroupId"
                   OnRequestDeleteGroup="RequestDeleteGroup"
                   OnCancelDeleteGroup="CancelDeleteGroup"
                   OnDeleteGroup="DeleteGroupAsync"
                   OnEditStub="EditStub"
                   OnDuplicateStub="DuplicateStubAsync"
                   OnDeleteStub="DeleteStubAsync"
                   OnToggleStub="ToggleStubAsync" />
}

@code {
    private GroupNode? _tree;
    private string _newGroupName = "";
    private Guid? _pendingDeleteGroupId;
    private bool _canUndo;
    private bool _canRedo;
    private ImportMode _importMode = ImportMode.ReplaceAll;
    private string? _importError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var groups = await Groups.ListAsync();
        var stubs = await StubSvc.ListAsync();
        _tree = GroupTree.Build(groups, stubs);
        _canUndo = await History.CanUndoAsync();
        _canRedo = await History.CanRedoAsync();
    }

    private async Task RecordAndReloadAsync(string summary)
    {
        await History.RecordAsync(summary);
        await LoadAsync();
    }

    private async Task AddGroupAsync()
    {
        if (string.IsNullOrWhiteSpace(_newGroupName)) return;
        var name = _newGroupName.Trim();
        await Groups.CreateAsync(name);
        _newGroupName = "";
        await RecordAndReloadAsync($"Added group '{name}'");
    }

    private void RequestDeleteGroup(Group group) => _pendingDeleteGroupId = group.Id;

    private void CancelDeleteGroup() => _pendingDeleteGroupId = null;

    private async Task DeleteGroupAsync(Group group)
    {
        await Groups.DeleteAsync(group.Id);
        _pendingDeleteGroupId = null;
        await RecordAndReloadAsync($"Deleted group '{group.Name}'");
    }

    private void EditStub(Stub stub) => Nav.NavigateTo($"/stubs/{stub.Id}");

    private async Task DuplicateStubAsync(Stub stub)
    {
        await StubSvc.DuplicateAsync(stub.Id);
        await RecordAndReloadAsync($"Duplicated stub '{stub.Name}'");
    }

    private async Task DeleteStubAsync(Stub stub)
    {
        await StubSvc.DeleteAsync(stub.Id);
        await RecordAndReloadAsync($"Deleted stub '{stub.Name}'");
    }

    private async Task ToggleStubAsync((Stub Stub, bool Enabled) change)
    {
        await StubSvc.SetEnabledAsync(change.Stub.Id, change.Enabled);
        var verb = change.Enabled ? "Enabled" : "Disabled";
        await RecordAndReloadAsync($"{verb} stub '{change.Stub.Name}'");
    }

    private async Task UndoAsync()
    {
        await History.UndoAsync();
        await LoadAsync();
    }

    private async Task RedoAsync()
    {
        await History.RedoAsync();
        await LoadAsync();
    }

    private async Task OnImportAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            var json = await reader.ReadToEndAsync();
            await Porter.ImportJsonAsync(json, _importMode);
            await History.RecordAsync($"Imported configuration ({_importMode})");
            _importError = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _importError = ex.Message;
        }
    }
}
