@page "/"
@rendermode InteractiveServer
@inject StubService StubSvc
@inject GroupService Groups
@inject NavigationManager Nav

<h1>Stubs</h1>

<div class="toolbar">
    <button @onclick="@(() => Nav.NavigateTo("/stubs/new"))">New stub</button>
    <input type="text" placeholder="New group name" @bind="_newGroupName" />
    <button @onclick="AddGroupAsync">Add group</button>
</div>

@if (_tree is null)
{
    <p>Loading…</p>
}
else if (_tree.Children.Count == 0 && _tree.Stubs.Count == 0)
{
    <p>No stubs or groups yet. Create one to start mocking.</p>
}
else
{
    <GroupTreeView Node="_tree"
                   PendingDeleteGroupId="_pendingDeleteGroupId"
                   OnRequestDeleteGroup="RequestDeleteGroup"
                   OnCancelDeleteGroup="CancelDeleteGroup"
                   OnDeleteGroup="DeleteGroupAsync"
                   OnEditStub="EditStub"
                   OnDuplicateStub="DuplicateStubAsync"
                   OnDeleteStub="DeleteStubAsync"
                   OnToggleStub="ToggleStubAsync" />
}

@code {
    private GroupNode? _tree;
    private string _newGroupName = "";
    private Guid? _pendingDeleteGroupId;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var groups = await Groups.ListAsync();
        var stubs = await StubSvc.ListAsync();
        _tree = GroupTree.Build(groups, stubs);
    }

    private async Task AddGroupAsync()
    {
        if (string.IsNullOrWhiteSpace(_newGroupName)) return;
        await Groups.CreateAsync(_newGroupName.Trim());
        _newGroupName = "";
        await LoadAsync();
    }

    private void RequestDeleteGroup(Group group) => _pendingDeleteGroupId = group.Id;

    private void CancelDeleteGroup() => _pendingDeleteGroupId = null;

    private async Task DeleteGroupAsync(Group group)
    {
        await Groups.DeleteAsync(group.Id);
        _pendingDeleteGroupId = null;
        await LoadAsync();
    }

    private void EditStub(Stub stub) => Nav.NavigateTo($"/stubs/{stub.Id}");

    private async Task DuplicateStubAsync(Stub stub)
    {
        await StubSvc.DuplicateAsync(stub.Id);
        await LoadAsync();
    }

    private async Task DeleteStubAsync(Stub stub)
    {
        await StubSvc.DeleteAsync(stub.Id);
        await LoadAsync();
    }

    private async Task ToggleStubAsync((Stub Stub, bool Enabled) change)
    {
        await StubSvc.SetEnabledAsync(change.Stub.Id, change.Enabled);
        await LoadAsync();
    }
}
