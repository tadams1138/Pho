@page "/stubs/new"
@page "/stubs/{Id:guid}"
@rendermode InteractiveServer
@inject StubService Stubs
@inject GroupService Groups
@inject ConfigHistoryService History
@inject NavigationManager Nav

<h1>@(Id is null ? "New stub" : "Edit stub")</h1>

@if (_error is not null)
{
    <p style="color:#b00020">@_error</p>
}

<label>Name
    <input type="text" @bind="_name" spellcheck="true" />
</label>

<label>Description
    <input type="text" @bind="_description" spellcheck="true" />
</label>

<label>Group
    <select @bind="_groupId">
        <option value="">(none)</option>
        @foreach (var group in _groups)
        {
            <option value="@group.Id">@group.Name</option>
        }
    </select>
</label>

<label>Method
    <select @bind="_method">
        @foreach (var m in Enum.GetValues<HttpMethodMatch>())
        {
            <option value="@m">@m</option>
        }
    </select>
</label>

<label>Path match type
    <select @bind="_pathType">
        @foreach (var t in Enum.GetValues<PathMatchType>())
        {
            <option value="@t">@t</option>
        }
    </select>
</label>

<label>Path
    <input type="text" @bind="_path" />
</label>

<label>Request body match
    <select @bind="_bodyMatchType">
        <option value="">(no body match)</option>
        @foreach (var t in Enum.GetValues<MatchRuleType>())
        {
            <option value="@t">@t</option>
        }
    </select>
</label>

@if (!string.IsNullOrEmpty(_bodyMatchType) && _bodyMatchType is not "Present" and not "Absent")
{
    <div>Request body value</div>
    <BodyEditor @bind-Value="_bodyMatchValue" />
}

<label>Response status
    <input type="number" @bind="_status" />
</label>

<div>Response body</div>
<BodyEditor @bind-Value="_body" />

<label>
    <input type="checkbox" @bind="_enabled" /> Enabled
</label>

<div class="toolbar">
    <button @onclick="SaveAsync">Save</button>
    <button @onclick="@(() => Nav.NavigateTo("/"))">Cancel</button>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private IReadOnlyList<Group> _groups = new List<Group>();
    private RequestMatcher? _baseRequest;
    private string _name = "";
    private string _description = "";
    private string _groupId = "";
    private HttpMethodMatch _method = HttpMethodMatch.Get;
    private PathMatchType _pathType = PathMatchType.Exact;
    private string _path = "/";
    private string _bodyMatchType = "";
    private string _bodyMatchValue = "";
    private int _status = 200;
    private string _body = "";
    private bool _enabled = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _groups = await Groups.ListAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id is Guid id)
        {
            var existing = await Stubs.GetAsync(id);
            if (existing is not null)
            {
                _name = existing.Name;
                _description = existing.Description ?? "";
                _groupId = existing.GroupId?.ToString() ?? "";
                _baseRequest = existing.Request;
                _method = existing.Request.Method;
                _pathType = existing.Request.Path.Type;
                _path = existing.Request.Path.Value;
                _bodyMatchType = existing.Request.Body?.Type.ToString() ?? "";
                _bodyMatchValue = existing.Request.Body?.Value ?? "";
                _status = existing.Response.Status;
                _body = existing.Response.Body;
                _enabled = existing.Enabled;
            }
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Name is required."; return; }
        if (string.IsNullOrWhiteSpace(_path)) { _error = "Path is required."; return; }

        var groupId = string.IsNullOrEmpty(_groupId) ? (Guid?)null : Guid.Parse(_groupId);
        var bodyRule = string.IsNullOrEmpty(_bodyMatchType)
            ? null
            : new MatchRule(Enum.Parse<MatchRuleType>(_bodyMatchType), _bodyMatchValue);

        // Preserve any query/header matchers that aren't editable in this minimal form.
        var baseRequest = _baseRequest ?? new RequestMatcher { Path = new PathMatcher(_pathType, _path) };
        var request = baseRequest with
        {
            Method = _method,
            Path = new PathMatcher(_pathType, _path),
            Body = bodyRule
        };
        var response = new ResponseDefinition { Status = _status, Body = _body };
        var description = string.IsNullOrWhiteSpace(_description) ? null : _description;

        if (Id is Guid id)
        {
            var existing = await Stubs.GetAsync(id);
            if (existing is not null)
            {
                existing.Name = _name;
                existing.Description = description;
                existing.GroupId = groupId;
                existing.Enabled = _enabled;
                existing.Request = request;
                existing.Response = response;
                await Stubs.UpdateAsync(existing);
            }
        }
        else
        {
            await Stubs.CreateAsync(new Stub
            {
                Name = _name,
                Description = description,
                GroupId = groupId,
                Enabled = _enabled,
                Request = request,
                Response = response
            });
        }

        await History.RecordAsync($"Saved stub '{_name}'");
        Nav.NavigateTo("/");
    }
}
