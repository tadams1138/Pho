<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Everything the UI links to is relative to this. A reverse proxy may mount the app under a
       sub-path, which arrives as the request's PathBase; served at a host root this is just "/".
       See docs/spec/08-architecture.md (Hosting behind a reverse proxy). *@
    <base href="@BaseHref" />
    <title>Pho — Mock Web Service</title>
    <style>
        :root { --bg: #ffffff; --fg: #1a1a1a; --border: #e5e5e5; --muted: #666; --accent: #0b5; --err: #b00020; }
        @@media (prefers-color-scheme: dark) {
            :root { --bg: #1e1e1e; --fg: #ececec; --border: #3a3a3a; --muted: #a0a0a0; --accent: #3d9; --err: #ff6b81; }
        }
        :root[data-theme="light"] { --bg: #ffffff; --fg: #1a1a1a; --border: #e5e5e5; --muted: #666; --accent: #0b5; --err: #b00020; }
        :root[data-theme="dark"] { --bg: #1e1e1e; --fg: #ececec; --border: #3a3a3a; --muted: #a0a0a0; --accent: #3d9; --err: #ff6b81; }

        body { font-family: system-ui, sans-serif; margin: 0; color: var(--fg); background: var(--bg); }
        /* Wide: the tree and the editor sit side by side, and stub paths are long. */
        main { max-width: 1600px; margin: 0 auto; padding: 1.5rem; }
        header h1 { font-size: 1.4rem; }
        header nav a { margin-right: 1rem; color: var(--accent); }
        table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--border); }
        button { margin-right: 0.35rem; }
        label { display: block; margin: 0.6rem 0; }
        input[type=text], input[type=number], textarea, select {
            width: 100%; max-width: 32rem; padding: 0.3rem;
            background: var(--bg); color: var(--fg); border: 1px solid var(--border);
        }
        textarea, .body-editor { min-height: 6rem; font-family: monospace; }
        .toolbar { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; }
        .body-tools { display: flex; gap: 0.35rem; align-items: center; margin: 0.3rem 0 0.8rem; flex-wrap: wrap; }
        .body-tools .ok { color: var(--accent); }
        .body-tools .err { color: var(--err); }
        .backup-toolbar { border: 1px solid var(--border); border-radius: 4px; padding: 0.4rem 0.6rem; }
        .toolbar-label { font-weight: 600; font-size: 0.85rem; color: var(--muted); }
        .toolbar .inline, label.inline { display: inline-flex; align-items: center; gap: 0.35rem; margin: 0; width: auto; }
        .toolbar select, .toolbar input[type=text] { width: auto; max-width: 14rem; }

        /* Stub tree + editor, side by side. */
        .workspace { display: flex; gap: 1rem; align-items: flex-start; flex-wrap: wrap; }
        .tree-pane { flex: 1 1 30rem; min-width: 20rem; }
        .editor-pane { flex: 1 1 34rem; min-width: 22rem; border-left: 1px solid var(--border); padding-left: 1rem;
                       /* Stays put while the tree scrolls inside its own box. */
                       position: sticky; top: 0.5rem; }
        .hint { font-size: 0.8rem; margin: 0 0 0.4rem; }
        .muted { color: var(--muted); }
        .tree-toolbar { margin-bottom: 0.4rem; }

        /* The tree scrolls in both directions inside a bounded box, so the editor beside it stays
           on screen however long the tree is, and long paths scroll sideways instead of wrapping. */
        .tree { border: 1px solid var(--border); border-radius: 4px; padding: 0.25rem;
                max-height: calc(100vh - 26rem); min-height: 12rem; overflow: auto; overscroll-behavior: contain; }
        .tree:focus { outline: 2px solid var(--accent); }
        /* max-content + min-width keeps every row one unwrapped line while the selection highlight
           still spans the full width; border-box so the indent padding does not overflow. */
        .tree-row { display: flex; align-items: center; gap: 0.4rem; padding: 0.15rem 0.3rem; cursor: pointer;
                    white-space: nowrap; width: max-content; min-width: 100%; box-sizing: border-box; }
        .tree-row > * { flex: 0 0 auto; }
        .tree-row.selected { background: color-mix(in srgb, var(--accent) 18%, transparent); }
        .tree-row.active { outline: 1px dashed var(--accent); }
        .tree-row.drop-target { background: color-mix(in srgb, var(--accent) 32%, transparent); }
        .tree-row.disabled .stub-label { text-decoration: line-through; color: var(--muted); }
        .tree-row input.row-select { width: auto; }
        .twisty { background: none; border: none; color: var(--fg); cursor: pointer; padding: 0 0.2rem; margin: 0; }
        .twisty:disabled { color: var(--muted); cursor: default; }
        .twisty-spacer { display: inline-block; width: 1rem; }
        .stub-summary { color: var(--muted); font-family: monospace; font-size: 0.85rem; }
        .disabled-tag { color: var(--muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em;
                        border: 1px solid var(--border); border-radius: 3px; padding: 0 0.25rem; }
        .tree-root-drop { margin-top: 0.3rem; padding: 0.4rem; border: 1px dashed var(--border); border-radius: 4px;
                          color: var(--muted); font-size: 0.8rem; text-align: center;
                          position: sticky; left: 0; }
        .tree-root-drop.drop-target { border-color: var(--accent); color: var(--fg); }
        .group { font-weight: 600; }

        .editor-header { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
        .editor-header h2 { font-size: 1.1rem; margin: 0.2rem 0; }
        .editor-actions { margin-left: auto; }
        .dirty-flag { font-size: 0.8rem; }
        .dirty-flag.dirty { color: var(--err); }
        .dirty-flag.clean { color: var(--muted); }
        button.primary { font-weight: 600; }
        button.danger { color: var(--err); }
        .errors { color: var(--err); margin: 0.4rem 0; padding-left: 1.2rem; }
        .confirm-bar { border: 1px solid var(--err); border-radius: 4px; padding: 0.5rem 0.6rem; margin-bottom: 1rem;
                       display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
        .confirm-bar.unsaved { border-color: var(--accent); }
        /* Path + its match type on one line; the path takes the slack. */
        .field-row { display: flex; gap: 0.8rem; align-items: flex-end; flex-wrap: wrap; }
        .field-row > label { margin: 0.6rem 0; }
        .field-row > label.grow { flex: 1 1 18rem; }
        .field-row > label.grow input { max-width: none; }

        /* Collapsible rule sections: open only when the stub has rules of that kind. */
        details.section { border: 1px solid var(--border); border-radius: 4px; padding: 0.35rem 0.6rem; margin: 0.6rem 0; }
        details.section > summary { cursor: pointer; font-weight: 600; }
        details.section[open] > summary { margin-bottom: 0.5rem; }
        details.section > summary::marker { color: var(--muted); }
        .auth-helper { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;
                       margin-top: 0.6rem; padding-top: 0.5rem; border-top: 1px dashed var(--border); }
        .auth-helper input { width: auto; max-width: 11rem; }

        table.rules { margin: 0.2rem 0 0.4rem; }
        table.rules input, table.rules select { max-width: 14rem; }
        table.rules th { font-size: 0.8rem; color: var(--muted); }
        .detail code { display: block; }
        .theme-toggle { margin-left: auto; font-size: 0.85rem; }
    </style>
    <script>
        // Apply any stored theme before render to avoid a flash.
        (function () {
            try {
                var t = localStorage.getItem('pho-theme');
                if (t) document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
        })();
        function phoSetTheme(t) {
            try {
                if (t === 'system') { localStorage.removeItem('pho-theme'); document.documentElement.removeAttribute('data-theme'); }
                else { localStorage.setItem('pho-theme', t); document.documentElement.setAttribute('data-theme', t); }
            } catch (e) { }
        }

        // Warn before a reload or tab close while the stub editor holds unsaved changes.
        // (In-app navigation is guarded server-side by the Stubs page.)
        var phoUnsaved = false;
        function phoSetUnsaved(value) { phoUnsaved = !!value; }
        window.addEventListener('beforeunload', function (e) {
            if (!phoUnsaved) return;
            e.preventDefault();
            e.returnValue = '';
            return '';
        });

        var phoTree = {
            // The tree handles these keys itself; stop the browser scrolling the page as well.
            capture: function (el) {
                if (!el || el.dataset.phoKeys === '1') return;
                el.dataset.phoKeys = '1';
                el.addEventListener('keydown', function (e) {
                    if (e.target !== el) return;
                    switch (e.key) {
                        case 'ArrowUp': case 'ArrowDown': case 'ArrowLeft': case 'ArrowRight':
                        case 'Home': case 'End': case ' ': case 'Spacebar':
                            e.preventDefault();
                    }
                });
            },
            reveal: function (id) {
                var row = document.getElementById(id);
                if (row) row.scrollIntoView({ block: 'nearest' });
            }
        };
    </script>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>The sub-path the app is being served under, slash-terminated; "/" at a host root.</summary>
    private string BaseHref
    {
        get
        {
            var pathBase = HttpContext?.Request.PathBase.Value;
            if (string.IsNullOrEmpty(pathBase)) return "/";

            return pathBase.EndsWith('/') ? pathBase : pathBase + "/";
        }
    }
}
