@inject IJSRuntime JS

@* The stub tree, rendered from the flattened row list: multi-select with checkboxes and
   ctrl/shift-click, arrow-key navigation, and drag-and-drop rearranging. Deleting and
   enabling/disabling are toolbar actions over the selection, so rows carry no buttons of their
   own beyond the twisty. Every row is a single unwrapped line — the tree scrolls sideways for
   long paths rather than reflowing. *@

<div class="tree" tabindex="0" role="tree" aria-multiselectable="true" @ref="_treeElement"
     @onkeydown="OnKeyDownAsync"
     @ondragover:preventDefault="true"
     @ondrop="() => OnDropAsync(null)">

    @foreach (var row in Rows)
    {
        <div @key="row.Id"
             id="@RowElementId(row.Id)"
             class="tree-row @RowClass(row)"
             role="treeitem"
             aria-selected="@(Selection.Contains(row.Id) ? "true" : "false")"
             style="@Indent(row)"
             draggable="true"
             @ondragstart="() => OnDragStart(row)"
             @ondragend="OnDragEnd"
             @ondragenter="() => OnDragEnter(row)"
             @ondragleave="() => OnDragLeave(row)"
             @ondragover:preventDefault="true"
             @ondrop:stopPropagation="true"
             @ondrop="() => OnDropAsync(row)"
             @onclick="args => OnRowClickAsync(row, args)">

            <input type="checkbox" class="row-select"
                   checked="@Selection.Contains(row.Id)"
                   aria-label="Select @row.Label"
                   @onclick:stopPropagation="true"
                   @onchange="() => OnToggleSelection.InvokeAsync(row)" />

            @if (row.Kind == TreeRowKind.Group)
            {
                var group = row.Group!;

                <button type="button" class="twisty"
                        aria-label="@(row.Expanded ? "Collapse" : "Expand") @group.Name"
                        disabled="@(!row.HasChildren)"
                        @onclick:stopPropagation="true"
                        @onclick="() => OnToggleExpand.InvokeAsync(group.Id)">@Twisty(row)</button>
                <span class="group">📁 @group.Name</span>
            }
            else
            {
                var stub = row.Stub!;

                @* A named stub shows its name and nothing else; an unnamed one shows what it
                   matches instead, so the row is never blank and never says the same thing twice. *@
                <span class="twisty-spacer"></span>
                <span class="stub-label @(StubLabel.HasName(stub) ? "stub-name" : "stub-summary")">@row.Label</span>
                @if (!stub.Enabled)
                {
                    <span class="disabled-tag" title="This stub is ignored while matching">disabled</span>
                }
            }
        </div>
    }

    <div class="tree-root-drop @(_dragging is not null && _dropTargetId is null ? "drop-target" : "")"
         @ondragover:preventDefault="true"
         @ondragenter="() => OnDragEnter(null)"
         @ondrop:stopPropagation="true"
         @ondrop="() => OnDropAsync(null)">
        Drop here to move to the top level
    </div>
</div>

@code {
    [Parameter] public required IReadOnlyList<TreeRow> Rows { get; set; }
    [Parameter] public required TreeSelection Selection { get; set; }

    /// <summary>The row the keyboard is on — also the row whose stub the editor panel shows.</summary>
    [Parameter] public Guid? ActiveId { get; set; }

    [Parameter] public EventCallback<RowActivation> OnActivate { get; set; }
    [Parameter] public EventCallback<TreeRow> OnToggleSelection { get; set; }
    [Parameter] public EventCallback<Guid> OnToggleExpand { get; set; }
    [Parameter] public EventCallback<RowDrop> OnDrop { get; set; }
    [Parameter] public EventCallback OnDeleteSelection { get; set; }

    private ElementReference _treeElement;
    private TreeRow? _dragging;
    private Guid? _dropTargetId;
    private Guid? _revealed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Stop the page scrolling when the tree itself is handling an arrow key.
            await JS.InvokeVoidAsync("phoTree.capture", _treeElement);
        }

        if (ActiveId != _revealed)
        {
            _revealed = ActiveId;
            if (ActiveId is Guid id) await JS.InvokeVoidAsync("phoTree.reveal", RowElementId(id));
        }
    }

    private static string RowElementId(Guid id) => $"tree-row-{id}";

    // Invariant formatting: a comma decimal separator would produce invalid CSS.
    private static string Indent(TreeRow row)
        => FormattableString.Invariant($"padding-left:{0.4 + row.Depth * 1.1:0.##}rem");

    private static string Twisty(TreeRow row) => !row.HasChildren ? "·" : row.Expanded ? "▾" : "▸";

    private string RowClass(TreeRow row)
    {
        var classes = new List<string> { row.Kind == TreeRowKind.Group ? "row-group" : "row-stub" };
        if (Selection.Contains(row.Id)) classes.Add("selected");
        if (ActiveId == row.Id) classes.Add("active");
        if (_dragging is not null && _dropTargetId == row.Id) classes.Add("drop-target");
        if (row.Kind == TreeRowKind.Stub && !row.Stub!.Enabled) classes.Add("disabled");

        return string.Join(' ', classes);
    }

    private Task OnRowClickAsync(TreeRow row, MouseEventArgs args)
        => OnActivate.InvokeAsync(new RowActivation(row, args.CtrlKey || args.MetaKey, args.ShiftKey));

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        var index = ActiveId is Guid id ? IndexOf(id) : -1;
        var current = index >= 0 ? Rows[index] : null;

        switch (args.Key)
        {
            case "ArrowDown":
                await ActivateAtAsync(index < 0 ? 0 : index + 1, args);
                break;

            case "ArrowUp":
                await ActivateAtAsync(index < 0 ? Rows.Count - 1 : index - 1, args);
                break;

            case "Home":
                await ActivateAtAsync(0, args);
                break;

            case "End":
                await ActivateAtAsync(Rows.Count - 1, args);
                break;

            case "ArrowRight":
                if (current is { Kind: TreeRowKind.Group, HasChildren: true })
                {
                    if (!current.Expanded) await OnToggleExpand.InvokeAsync(current.Id);
                    else await ActivateAtAsync(index + 1, args);
                }
                break;

            case "ArrowLeft":
                if (current is { Kind: TreeRowKind.Group, HasChildren: true, Expanded: true })
                    await OnToggleExpand.InvokeAsync(current.Id);
                else if (current?.ParentGroupId is Guid parent && IndexOf(parent) >= 0)
                    await ActivateAtAsync(IndexOf(parent), args);
                break;

            case " ":
            case "Spacebar":
                if (current is not null) await OnToggleSelection.InvokeAsync(current);
                break;

            case "Delete":
                await OnDeleteSelection.InvokeAsync();
                break;
        }
    }

    private Task ActivateAtAsync(int index, KeyboardEventArgs args)
    {
        if (Rows.Count == 0) return Task.CompletedTask;

        index = Math.Clamp(index, 0, Rows.Count - 1);

        return OnActivate.InvokeAsync(new RowActivation(Rows[index], Ctrl: false, Shift: args.ShiftKey));
    }

    private int IndexOf(Guid id)
    {
        for (var i = 0; i < Rows.Count; i++)
        {
            if (Rows[i].Id == id) return i;
        }

        return -1;
    }

    private void OnDragStart(TreeRow row)
    {
        _dragging = row;
        _dropTargetId = null;
    }

    private void OnDragEnd()
    {
        _dragging = null;
        _dropTargetId = null;
    }

    private void OnDragEnter(TreeRow? row) => _dropTargetId = row?.Id;

    private void OnDragLeave(TreeRow row)
    {
        if (_dropTargetId == row.Id) _dropTargetId = null;
    }

    private async Task OnDropAsync(TreeRow? target)
    {
        var dragged = _dragging;
        OnDragEnd();
        if (dragged is null || dragged.Id == target?.Id) return;

        await OnDrop.InvokeAsync(new RowDrop(dragged, target));
    }
}
