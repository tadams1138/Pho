@* The stub editor, shown beside the tree whenever a single stub is selected. It edits a
   StubDraft; the page compares that draft with the last saved copy to know whether leaving
   needs a warning. See docs/spec/05-screens-and-flows.md (stub editor). *@

<div class="editor-header">
    <h2>@(IsNew ? "New stub" : Draft.Name is { Length: > 0 } name ? name : "Stub")</h2>
    <span class="dirty-flag @(IsDirty ? "dirty" : "clean")">
        @(IsDirty ? "● Unsaved changes" : IsNew ? "Not saved yet" : "Saved")
    </span>
    <div class="editor-actions">
        <button type="button" class="primary" disabled="@(!IsDirty && !IsNew)" @onclick="() => OnSave.InvokeAsync()">Save</button>
        <button type="button" disabled="@(!IsDirty)" @onclick="() => OnRevert.InvokeAsync()">Revert</button>
        @if (!IsNew)
        {
            <button type="button" @onclick="() => OnDuplicate.InvokeAsync()">Duplicate</button>
        }
        <button type="button" @onclick="() => OnClose.InvokeAsync()">Close</button>
    </div>
</div>

@if (Errors.Count > 0)
{
    <ul class="errors">
        @foreach (var error in Errors)
        {
            <li>@error</li>
        }
    </ul>
}

@* Left blank, the name is filled in from the method and path when the stub is saved. *@
<label>Name
    <input type="text" value="@Draft.Name" spellcheck="true" placeholder="@Draft.DefaultName"
           @oninput="e => SetAsync(() => Draft.Name = e.Value?.ToString() ?? string.Empty)" />
</label>

<label>Description
    <input type="text" value="@Draft.Description" spellcheck="true"
           @oninput="e => SetAsync(() => Draft.Description = e.Value?.ToString() ?? string.Empty)" />
</label>

@* No group control: the tree already shows where the stub lives, and a stub is moved by dragging it. *@
<label class="inline">
    <input type="checkbox" checked="@Draft.Enabled"
           @onchange="e => SetAsync(() => Draft.Enabled = (bool)e.Value!)" /> Enabled
</label>

<h3>Request</h3>

<label>Method
    <select value="@Draft.Method"
            @onchange="e => SetAsync(() => Draft.Method = Enum.Parse<HttpMethodMatch>(e.Value!.ToString()!))">
        @foreach (var method in Enum.GetValues<HttpMethodMatch>())
        {
            <option value="@method">@method</option>
        }
    </select>
</label>

@* Path and its match type share a line — the type qualifies the path rather than standing alone. *@
<div class="field-row">
    <label class="grow">Path
        <input type="text" value="@Draft.Path"
               @oninput="e => SetAsync(() => Draft.Path = e.Value?.ToString() ?? string.Empty)" />
    </label>
    <label>Path match type
        <select value="@Draft.PathType"
                @onchange="e => SetAsync(() => Draft.PathType = Enum.Parse<PathMatchType>(e.Value!.ToString()!))">
            @foreach (var type in Enum.GetValues<PathMatchType>())
            {
                <option value="@type">@type</option>
            }
        </select>
    </label>
</div>

@* The repeatable sections open only when the stub actually has rules of that kind, so an ordinary
   stub is a short form rather than three empty tables. *@
<details class="section" open="@(Draft.QueryParams.Count > 0)">
    <summary>Query parameter rules @Count(Draft.QueryParams.Count)</summary>
    <RuleRowsEditor Rows="Draft.QueryParams" Noun="Query parameter" Placeholder="page" OnChanged="OnChanged" />
</details>

<details class="section" open="@(Draft.RequestHeaders.Count > 0)">
    <summary>Header rules @Count(Draft.RequestHeaders.Count)</summary>
    <p class="muted">A stub only matches when every header rule matches; header names are compared case-insensitively.</p>
    <RuleRowsEditor Rows="Draft.RequestHeaders" Noun="Header" Placeholder="Authorization" OnChanged="OnChanged" />

    @* Basic auth helper (F12): base64 is not something to do by hand mid-test. *@
    <div class="auth-helper">
        <span class="toolbar-label">Basic auth</span>
        <label class="inline">User ID
            <input type="text" value="@_basicUserId" autocomplete="off"
                   @oninput="e => _basicUserId = e.Value?.ToString() ?? string.Empty" />
        </label>
        <label class="inline">Password
            <input type="text" value="@_basicPassword" autocomplete="off"
                   @oninput="e => _basicPassword = e.Value?.ToString() ?? string.Empty" />
        </label>
        <button type="button" disabled="@(_basicUserId.Length == 0 && _basicPassword.Length == 0)"
                title="Base64-encode these as user:password and set the Authorization header rule"
                @onclick="ApplyBasicAuthAsync">
            Set Authorization header
        </button>
        @if (Draft.CurrentBasicAuth() is not null)
        {
            <span class="muted" title="@BasicAuth.Describe(CurrentAuthorizationValue())">
                Matching a Basic credential — hover to read it
            </span>
        }
    </div>
</details>

<h4>Body rule</h4>
<label class="inline">
    <input type="checkbox" checked="@Draft.MatchBody"
           @onchange="e => SetAsync(() => Draft.MatchBody = (bool)e.Value!)" /> Match on the request body
</label>

@if (Draft.MatchBody)
{
    <label>Body rule
        <select value="@Draft.BodyMatchType"
                @onchange="e => SetAsync(() => Draft.BodyMatchType = Enum.Parse<MatchRuleType>(e.Value!.ToString()!))">
            @foreach (var type in Enum.GetValues<MatchRuleType>())
            {
                <option value="@type">@type</option>
            }
        </select>
    </label>

    @if (ParamRuleDraft.TakesIgnoreCase(Draft.BodyMatchType))
    {
        <label class="inline">
            <input type="checkbox" checked="@Draft.BodyIgnoreCase"
                   @onchange="e => SetAsync(() => Draft.BodyIgnoreCase = (bool)e.Value!)" /> Ignore case
        </label>
    }

    @if (ParamRuleDraft.TakesValue(Draft.BodyMatchType))
    {
        <div>Request body value</div>
        <BodyEditor Value="@Draft.BodyMatchValue" ValueChanged="value => SetAsync(() => Draft.BodyMatchValue = value)" />
    }
}

<h3>Response</h3>

<label>Status
    <input type="number" value="@Draft.Status"
           @oninput="e => SetAsync(() => Draft.Status = ParseStatus(e.Value, Draft.Status))" />
</label>

<details class="section" open="@(Draft.ResponseHeaders.Count > 0)">
    <summary>Response headers @Count(Draft.ResponseHeaders.Count)</summary>
    <HeaderRowsEditor Rows="Draft.ResponseHeaders" OnChanged="OnChanged" />
</details>

<div>Response body</div>
<BodyEditor Value="@Draft.Body" ValueChanged="value => SetAsync(() => Draft.Body = value)" />

@code {
    [Parameter] public required StubDraft Draft { get; set; }
    [Parameter] public bool IsDirty { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public IReadOnlyList<string> Errors { get; set; } = Array.Empty<string>();

    /// <summary>Raised after every edit so the page can recompute the unsaved-changes state.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnRevert { get; set; }
    [Parameter] public EventCallback OnDuplicate { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private StubDraft? _shownDraft;
    private string _basicUserId = "";
    private string _basicPassword = "";

    protected override void OnParametersSet()
    {
        // A different draft (another stub, or a reverted copy) refills the auth boxes from whatever
        // credential that stub already matches on, so an existing one can be edited rather than retyped.
        if (ReferenceEquals(_shownDraft, Draft)) return;

        _shownDraft = Draft;
        var credentials = Draft.CurrentBasicAuth();
        _basicUserId = credentials?.UserId ?? "";
        _basicPassword = credentials?.Password ?? "";
    }

    private Task SetAsync(Action apply)
    {
        apply();
        return OnChanged.InvokeAsync();
    }

    private Task ApplyBasicAuthAsync() => SetAsync(() => Draft.SetBasicAuth(_basicUserId, _basicPassword));

    private string? CurrentAuthorizationValue()
        => Draft.RequestHeaders
            .FirstOrDefault(r => string.Equals(r.Name.Trim(), BasicAuth.HeaderName, StringComparison.OrdinalIgnoreCase))
            ?.Value;

    private static string Count(int count) => count == 0 ? "(none)" : $"({count})";

    private static int ParseStatus(object? value, int fallback)
        => int.TryParse(value?.ToString(), out var status) ? status : fallback;
}
