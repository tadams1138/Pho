@* Repeatable match-rule rows for query parameters or request headers (F1). *@

<table class="rules">
    <thead>
        <tr>
            <th>@Noun name</th>
            <th>Rule</th>
            <th>Value</th>
            <th title="Compare the value without regard to case">Aa</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Rows)
        {
            <tr @key="row">
                <td>
                    <input type="text" value="@row.Name" placeholder="@Placeholder"
                           @oninput="e => SetAsync(() => row.Name = e.Value?.ToString() ?? string.Empty)" />
                </td>
                <td>
                    <select value="@row.Type"
                            @onchange="e => SetAsync(() => row.Type = Enum.Parse<MatchRuleType>(e.Value!.ToString()!))">
                        @foreach (var type in Enum.GetValues<MatchRuleType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </td>
                <td>
                    @if (ParamRuleDraft.TakesValue(row.Type))
                    {
                        @* A Basic credential reads back as its user id and password on hover (F12). *@
                        <input type="text" value="@row.Value" title="@BasicAuth.Describe(row.Value)"
                               @oninput="e => SetAsync(() => row.Value = e.Value?.ToString() ?? string.Empty)" />
                    }
                    else
                    {
                        <span class="muted">(existence only)</span>
                    }
                </td>
                <td>
                    @* Only EQUALS and CONTAINS can use it: a pattern says (?i) itself, and
                       PRESENT / ABSENT compare no value. See docs/spec/04-features.md (F1). *@
                    @if (ParamRuleDraft.TakesIgnoreCase(row.Type))
                    {
                        <input type="checkbox" checked="@row.IgnoreCase" title="Ignore case"
                               @onchange="e => SetAsync(() => row.IgnoreCase = (bool)e.Value!)" />
                    }
                </td>
                <td>
                    <button type="button" @onclick="() => SetAsync(() => Rows.Remove(row))">Remove</button>
                </td>
            </tr>
        }
        @if (Rows.Count == 0)
        {
            <tr><td colspan="5" class="muted">No @Noun.ToLowerInvariant() rules — any value matches.</td></tr>
        }
    </tbody>
</table>

<button type="button" @onclick="() => SetAsync(() => Rows.Add(new ParamRuleDraft()))">Add @Noun.ToLowerInvariant() rule</button>

@code {
    [Parameter] public required List<ParamRuleDraft> Rows { get; set; }

    /// <summary>What the rows describe, e.g. "Header" or "Query parameter".</summary>
    [Parameter] public required string Noun { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    private Task SetAsync(Action apply)
    {
        apply();
        return OnChanged.InvokeAsync();
    }
}
